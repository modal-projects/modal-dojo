# PATCHED_TRAINING_GYM_TIMING_PREAMBLE: bootstrap substep-timing recorder
import sys as _tg_sys
if '/root' not in _tg_sys.path:
    _tg_sys.path.insert(0, '/root')
try:
    from modal_dojo.common.timing_recorder import (
        RoleRecorder as _TgRecorder,
        recording_lane as _tg_role,
        recording_lane_on_reporting_rank as _tg_mrec,
        time_phase as _tg_time_phase,
    )
except ImportError:
    print('WARNING: modal_dojo not importable; substep timing off')
    from contextlib import contextmanager as _tg_cm

    class _TgRecorder:
        def __init__(self, role, rollout_id): pass

        def __enter__(self): return self

        def __exit__(self, *exc): pass

        @_tg_cm
        def phase(self, name):
            yield

    @_tg_cm
    def _tg_role(role, rollout_id):
        yield _TgRecorder(role, rollout_id)

    @_tg_cm
    def _tg_mrec(rollout_id, role='actor'):
        yield _TgRecorder(role, rollout_id)

    @_tg_cm
    def _tg_time_phase(name):
        yield

# PATCHED_TRAINING_GYM_PREAMBLE: bootstrap phase reporter (runs once per process)
import sys as _tg_sys
if '/root' not in _tg_sys.path:
    _tg_sys.path.insert(0, '/root')
try:
    from modal_dojo.frameworks.miles.phase_reporting import (
        report_step_event as _tg_report,
    )
except ImportError:
    def _tg_report(status, args=None, rollout_id=None): pass

import asyncio
import logging
import os

from miles.ray.placement_group import create_placement_groups, create_rollout_manager, create_training_models
from miles.ray.rollout.eval_dispatch import EvalDispatcher
from miles.utils import object_store
from miles.utils.arguments import parse_args, validate_async_off_policy_correction
from miles.utils.audit_utils.process_identity import MainProcessIdentity
from miles.utils.data import remove_rollout_data_refs
from miles.utils.debug_utils.periodic_py_spy import maybe_start_periodic_pyspy_dump
from miles.utils.ft_utils.control_server.server import start_control_server
from miles.utils.ft_utils.mini_ft_controller import maybe_start_mini_ft_controller
from miles.utils.logging_utils import configure_logger
from miles.utils.misc import should_run_periodic_action
from miles.utils.tracking_utils.tracking import finish_tracking, init_tracking

logger = logging.getLogger(__name__)


# The framework supports other asynchronous approaches such as fully async (see miles/rollout/fully_async_rollout.py).
async def train(args):
    assert not args.colocate, "Colocation is not supported for async training."
    validate_async_off_policy_correction(args)
    configure_logger(args, source=MainProcessIdentity())
    maybe_start_periodic_pyspy_dump()
    # allocate the GPUs
    pgs = create_placement_groups(args)
    object_store.init_instance(args, contribute_segment=False)
    init_tracking(args)

    # create the rollout manager, with sglang engines inside.
    # need to initialize rollout manager first to calculate num_rollout
    # PATCHED_TRAINING_GYM_ROLLOUT_STATUS: initialize_rollouts state
    _tg_report('initialize_rollouts', args, None)
    rollout_manager, num_rollout_per_epoch = create_rollout_manager(args, pgs["rollout"])

    # create the actor and critic models
    actor_model, critic_model = await create_training_models(args, pgs, rollout_manager)

    if args.control_server_port:
        start_control_server(
            actor_model=actor_model,
            rollout_manager=rollout_manager,
            port=args.control_server_port,
            ft_components=args.ft_components,
        )

    maybe_start_mini_ft_controller(args)

    # always update weight first so that sglang has the loaded weights from training.
    with _tg_role('driver', None) as _tg_rec:
        with _tg_rec.phase('initial_weight_sync'):
            await actor_model.update_weights()

    if args.check_weight_update_equal:
        await rollout_manager.check_weights.remote(
            action="compare",
            allow_quant_error=args.check_weight_update_allow_quant_error,
            selector=args.check_weight_update_selector,
            skip_list=args.check_weight_update_skip_list,
        )

    eval_dispatcher = EvalDispatcher(args, actor_model, rollout_manager)

    if args.eval_interval is not None and args.start_rollout_id == 0 and not args.skip_eval_before_train:
        if not args.eval_uses_snapshots:
            with _tg_role('driver', None) as _tg_rec:
                # PATCHED_TRAINING_GYM_TIMING_EVALUATE_ROLLOUTS
                with _tg_rec.phase('evaluate_rollouts'):
                    await eval_dispatcher.dispatch(0, hf_dir=args.hf_checkpoint)
        else:
            await eval_dispatcher.dispatch(0, hf_dir=args.hf_checkpoint)

    async def save_training_model(model, rollout_id, force_sync):
        if args.use_critic and args.offload_train:
            await model.onload()
        await model.save_model(rollout_id, force_sync=force_sync)
        if args.use_critic and args.offload_train:
            await model.offload()

    # async train loop.
    rollout_data_next_future = rollout_manager.generate.remote(args.start_rollout_id)
    for rollout_id in range(args.start_rollout_id, args.num_rollout):
        # PATCHED_TRAINING_GYM_TIMING_RECORDER: driver lane active
        with _tg_role('driver', rollout_id) as _tg_rec:
            # Sync the last generation
            if rollout_data_next_future is not None:
                # PATCHED_TRAINING_GYM_TIMING_WAIT_FOR_ROLLOUT
                with _tg_rec.phase('wait_for_rollout'):
                    rollout_data_curr_ref = await rollout_data_next_future

            # Start the next rollout early.
            if rollout_id + 1 < args.num_rollout:
                rollout_data_next_future = rollout_manager.generate.remote(rollout_id + 1)

            if args.use_critic:
                # PATCHED_TRAINING_GYM_TIMING_TRAIN_MODELS
                with _tg_rec.phase('train_models'):
                    values = await critic_model.train(rollout_id, rollout_data_curr_ref)
                if args.offload_train:
                    # PATCHED_TRAINING_GYM_TIMING_OFFLOAD_TRAIN
                    with _tg_rec.phase('offload_train'):
                        await critic_model.offload()
                if rollout_id >= args.num_critic_only_steps:
                    # PATCHED_TRAINING_GYM_COMPUTE_LOG_PROBS_STATUS: compute_log_probs state
                    _tg_report('compute_log_probs', args, rollout_id)
                    # PATCHED_TRAINING_GYM_TIMING_TRAIN_MODELS
                    with _tg_rec.phase('train_models'):
                        await actor_model.train(rollout_id, rollout_data_curr_ref, external_data=values)
                    if args.offload_train:
                        # PATCHED_TRAINING_GYM_TIMING_OFFLOAD_TRAIN
                        with _tg_rec.phase('offload_train'):
                            await actor_model.offload()
            else:
                # PATCHED_TRAINING_GYM_COMPUTE_LOG_PROBS_STATUS: compute_log_probs state
                _tg_report('compute_log_probs', args, rollout_id)
                # PATCHED_TRAINING_GYM_TIMING_TRAIN_MODELS
                with _tg_rec.phase('train_models'):
                    await actor_model.train(rollout_id, rollout_data_curr_ref)
            remove_rollout_data_refs(args, rollout_data_curr_ref)

            external_save = args.save_trigger_sentinel is not None and os.path.exists(args.save_trigger_sentinel)
            if external_save or should_run_periodic_action(
                rollout_id, args.save_interval, num_rollout_per_epoch, args.num_rollout
            ):
                # PATCHED_TRAINING_GYM_CHECKPOINT_SAVE_STATUS: checkpoint save state
                _tg_report('checkpoint_save', args, rollout_id)
                force_sync = external_save or rollout_id == args.num_rollout - 1
                # PATCHED_TRAINING_GYM_TIMING_CHECKPOINT_SAVE
                with _tg_rec.phase('checkpoint_save'):
                    await save_training_model(actor_model, rollout_id, force_sync)
                if args.use_critic:
                    # PATCHED_TRAINING_GYM_TIMING_CHECKPOINT_SAVE
                    with _tg_rec.phase('checkpoint_save'):
                        await save_training_model(critic_model, rollout_id, force_sync)
                await rollout_manager.save.remote(rollout_id)
                if external_save:
                    os.remove(args.save_trigger_sentinel)

            if (rollout_id + 1) % args.update_weights_interval == 0:
                # PATCHED_TRAINING_GYM_TIMING_WAIT_FOR_NEXT_ROLLOUT
                with _tg_rec.phase('wait_for_next_rollout'):
                    # sync generate before update weights to prevent update weight in the middle of generation
                    rollout_data_curr_ref = (await x) if (x := rollout_data_next_future) is not None else None
                    rollout_data_next_future = None
                # PATCHED_TRAINING_GYM_WEIGHT_SYNC_STATUS: weight_sync state
                _tg_report('weight_sync', args, rollout_id)
                # PATCHED_TRAINING_GYM_TIMING_WEIGHT_SYNC
                with _tg_rec.phase('weight_sync'):
                    await actor_model.update_weights(rollout_id=rollout_id)

            if should_run_periodic_action(rollout_id, args.eval_interval, num_rollout_per_epoch, args.num_rollout):
                if not args.eval_uses_snapshots:
                    # PATCHED_TRAINING_GYM_TIMING_EVALUATE_ROLLOUTS_END
                    with _tg_rec.phase('evaluate_rollouts_end'):
                        await eval_dispatcher.dispatch(rollout_id, force=rollout_id == args.num_rollout - 1)
                else:
                    await eval_dispatcher.dispatch(rollout_id, force=rollout_id == args.num_rollout - 1)

            if (
                args.debug_exit_after_rollout is not None
                and (rollout_id - args.start_rollout_id + 1) >= args.debug_exit_after_rollout
            ):
                logger.info(
                    "debug_exit_after_rollout=%d reached at rollout_id=%d, exiting",
                    args.debug_exit_after_rollout,
                    rollout_id,
                )
                break

    with _tg_role('driver', None) as _tg_rec:
        # PATCHED_TRAINING_GYM_TIMING_EVALUATE_ROLLOUTS_END
        with _tg_rec.phase('evaluate_rollouts_end'):
            await eval_dispatcher.drain()
    await rollout_manager.dispose.remote()


if __name__ == "__main__":
    args = parse_args()
    try:
        asyncio.run(train(args))
    finally:
        finish_tracking()
