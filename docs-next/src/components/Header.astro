---
import config from 'virtual:starlight/user-config';
import { DOCS_NAV, REFERENCE_SURFACES, referenceSurfaceForPath } from '../lib/docs-sections';
import Search from './Search.astro';

const currentPath = Astro.url.pathname;
const repoHref = 'https://github.com/modal-projects/modal-dojo';
const activeReference = referenceSurfaceForPath(currentPath);

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<div class="tg-header">
  <div class="tg-header__left">
    <a href="/" class="title-wrapper sl-flex">
      <img src="/modal-logo.svg" alt="Modal" />
      <span class="site-title"><span class="site-title__modal">Modal</span><span class="site-title__dojo">Dojo</span></span>
    </a>
    <nav class="tg-header__nav" aria-label="Primary">
      {DOCS_NAV.map((item) =>
        item.section === 'Reference' ? (
          <div class="tg-header__nav-dropdown">
            <button
              type="button"
              class:list={['tg-header__nav-link', { 'is-active': Boolean(activeReference) }]}
              aria-expanded="false"
              aria-controls="tg-header-reference-menu"
            >
              {item.section}
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div id="tg-header-reference-menu" class="tg-header__nav-menu" hidden>
              {REFERENCE_SURFACES.map((surface) => (
                <a
                  href={surface.href}
                  aria-current={activeReference?.href === surface.href ? 'page' : undefined}
                  class:list={['tg-header__nav-menu-item', { 'is-active': activeReference?.href === surface.href }]}
                >
                  {surface.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.prefix}
            class:list={['tg-header__nav-link', { 'is-active': isActive(item.prefix) }]}
          >
            {item.section}
          </a>
        )
      )}
    </nav>
  </div>
  <div class="tg-header__right print:hidden">
    {shouldRenderSearch && (
      <div class="tg-header__search">
        <Search class="tg-header__search" />
      </div>
    )}
    <a
      class="btn btn-outlined bg-c-gray-5 tg-header__repo"
      href={repoHref}
    >
      <svg
        class="text-c-gray-80 mr-2.5"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
        <path d="M9 18c-4.51 2-5-2-7-2"></path>
      </svg>
      <span class="text-c-gray-80 text-sm">Repo</span>
    </a>
    <details class="tg-header__menu">
      <summary aria-label="Open navigation">
        <span class="tg-header__hamburger-box">
          <span class="tg-header__hamburger-inner"></span>
        </span>
      </summary>
      <nav class="tg-header__menu-panel" aria-label="Primary">
        <a
          href={repoHref}
          class="tg-header__menu-link is-repo"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
          Repo
        </a>
        {DOCS_NAV.map((item) =>
          item.section === 'Reference' ? (
            <details class="tg-header__menu-group">
              <summary class="tg-header__menu-link tg-header__menu-group-label">
                {item.section}
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m9 18 6-6-6-6"></path>
                </svg>
              </summary>
              <div class="tg-header__menu-submenu">
                {REFERENCE_SURFACES.map((surface) => (
                  <a
                    href={surface.href}
                    aria-current={activeReference?.href === surface.href ? 'page' : undefined}
                    class:list={[
                      'tg-header__menu-link',
                      'tg-header__menu-sublink',
                      { 'is-active': activeReference?.href === surface.href },
                    ]}
                  >
                    {surface.label}
                  </a>
                ))}
              </div>
            </details>
          ) : (
            <a
              href={item.prefix}
              class:list={['tg-header__menu-link', { 'is-active': isActive(item.prefix) }]}
            >
              {item.section}
            </a>
          )
        )}
      </nav>
    </details>
  </div>
</div>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.tg-header__menu');
  const summary = menu?.querySelector<HTMLElement>(':scope > summary');
  const mobile = window.matchMedia('(max-width: 52.499rem)');
  const closeDuration = 300;
  let closeTimer: number | undefined;

  const syncMenuState = () => {
    document.body.toggleAttribute('data-mobile-menu-expanded', Boolean(menu?.open && mobile.matches));
    summary?.setAttribute('aria-label', menu?.open ? 'Close navigation' : 'Open navigation');
  };

  const closeMenu = (restoreFocus = false) => {
    if (!menu?.open || menu.classList.contains('is-closing')) return;
    if (!mobile.matches) {
      menu.open = false;
      if (restoreFocus) summary?.focus();
      return;
    }
    menu.classList.add('is-closing');
    window.clearTimeout(closeTimer);
    closeTimer = window.setTimeout(() => {
      menu.open = false;
      menu.classList.remove('is-closing');
      if (restoreFocus) summary?.focus();
    }, closeDuration);
  };

  summary?.addEventListener('click', (event) => {
    if (!menu?.open) return;
    event.preventDefault();
    closeMenu();
  });
  menu?.addEventListener('toggle', syncMenuState);
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      event.preventDefault();
      closeMenu(true);
    }
  }, { capture: true });
  mobile.addEventListener('change', syncMenuState);

  const groupCloseDuration = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 500;
  for (const group of document.querySelectorAll<HTMLDetailsElement>('.tg-header__menu-group')) {
    const groupSummary = group.querySelector<HTMLElement>(':scope > summary');
    let groupCloseTimer: number | undefined;
    groupSummary?.addEventListener('click', (event) => {
      if (!group.open || group.classList.contains('is-closing') || !mobile.matches) return;
      event.preventDefault();
      group.classList.add('is-closing');
      window.clearTimeout(groupCloseTimer);
      groupCloseTimer = window.setTimeout(() => {
        group.open = false;
        group.classList.remove('is-closing');
      }, groupCloseDuration());
    });
  }

  const hoverablePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  for (const dropdown of document.querySelectorAll<HTMLElement>('.tg-header__nav-dropdown')) {
    const dropdownTrigger = dropdown.querySelector<HTMLButtonElement>(':scope > button');
    const dropdownMenu = dropdown.querySelector<HTMLElement>(':scope > .tg-header__nav-menu');
    let dropdownCloseTimer: number | undefined;

    const setDropdownOpen = (open: boolean) => {
      if (!dropdownTrigger || !dropdownMenu) return;
      dropdownTrigger.setAttribute('aria-expanded', String(open));
      dropdownMenu.hidden = !open;
    };

    dropdown.addEventListener('pointerenter', () => {
      if (!hoverablePointer.matches) return;
      window.clearTimeout(dropdownCloseTimer);
      setDropdownOpen(true);
    });
    dropdown.addEventListener('pointerleave', () => {
      if (!hoverablePointer.matches || dropdown.matches(':focus-within')) return;
      dropdownCloseTimer = window.setTimeout(() => {
        if (!dropdown.matches(':focus-within')) {
          setDropdownOpen(false);
        }
      }, 120);
    });
    dropdown.addEventListener('focusin', () => {
      window.clearTimeout(dropdownCloseTimer);
      setDropdownOpen(true);
    });
    dropdown.addEventListener('focusout', () => {
      requestAnimationFrame(() => {
        if (!dropdown.matches(':focus-within') && !dropdown.matches(':hover')) {
          setDropdownOpen(false);
        }
      });
    });
    dropdownTrigger?.addEventListener('click', (event) => {
      event.preventDefault();
      setDropdownOpen(true);
    });
    dropdown.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && dropdownTrigger?.getAttribute('aria-expanded') === 'true') {
        event.preventDefault();
        dropdownTrigger.focus();
        setDropdownOpen(false);
      }
    });
    document.addEventListener('pointerdown', (event) => {
      if (!dropdown.contains(event.target as Node)) {
        setDropdownOpen(false);
      }
    });
  }
</script>
