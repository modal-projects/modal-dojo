---
import '@astrojs/starlight/style/markdown.css';

const slug = Astro.locals.starlightRoute.entry.id.replace(/^\/+/, '');
const isCli = slug === 'reference/cli' || slug.startsWith('reference/cli/');
const isCliIndex = slug === 'reference/cli';
---

<div class:list={['sl-markdown-content', { 'tg-cli': isCli, 'tg-cli-index': isCliIndex }]}><slot /></div>

<script is:inline>
  (() => {
    const ANCHOR_LINK = '.sl-anchor-link';
    const copiedLinks = new WeakMap();

    function fallbackCopy(text) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;left:-9999px';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      if (!ok) throw new Error('execCommand copy failed');
    }

    async function writeClipboard(text) {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return;
        }
      } catch {}
      fallbackCopy(text);
    }

    function markCopied(link, copied) {
      const icon = link.querySelector('.sl-anchor-icon');
      if (icon instanceof HTMLElement) icon.style.visibility = copied ? 'hidden' : '';
      let check = link.querySelector('.tg-anchor-copied');
      if (!copied) {
        check?.remove();
        return;
      }
      if (!check) {
        check = document.createElement('span');
        check.className = 'tg-anchor-copied';
        check.setAttribute('aria-hidden', 'true');
        check.style.cssText =
          'position:absolute;inset:0;display:inline-flex;align-items:center;justify-content:center';
        check.innerHTML =
          '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
        link.prepend(check);
      }
    }

    document.addEventListener('click', async (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
        return;
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest(ANCHOR_LINK);
      if (!(link instanceof HTMLAnchorElement) || !link.hash) return;
      event.preventDefault();
      const url = new URL(window.location.href);
      url.hash = link.hash;
      history.pushState(null, '', url);
      try {
        await writeClipboard(url.toString());
      } catch {
        return;
      }
      clearTimeout(copiedLinks.get(link));
      markCopied(link, true);
      copiedLinks.set(
        link,
        setTimeout(() => {
          markCopied(link, false);
          copiedLinks.delete(link);
        }, 1600),
      );
    });
  })();
</script>

<script is:inline>
  (() => {
    const TOC_LINK = '.tg-toc a';

    function linkTarget(link) {
      return decodeURIComponent(link.hash.replace(/^#/, ''));
    }

    function markCurrent(ids) {
      for (const link of document.querySelectorAll(TOC_LINK)) {
        if (ids.has(linkTarget(link))) {
          if (link.getAttribute('aria-current') !== 'true') {
            link.setAttribute('aria-current', 'true');
          }
        } else if (link.hasAttribute('aria-current')) {
          link.removeAttribute('aria-current');
        }
      }
    }

    const links = [...document.querySelectorAll(TOC_LINK)];
    const headings = [...new Set(links.map(linkTarget))].flatMap((id) => {
      const heading = document.getElementById(id);
      return heading ? [{ id, heading }] : [];
    });
    if (headings.length === 0) return;

    const active = new Set();
    const syncCurrent = () => {
      active.clear();
      for (const { id, heading } of headings) {
        const rect = heading.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) active.add(id);
      }
      const hashLink = links.find((link) => link.hash === location.hash);
      if (hashLink) active.add(linkTarget(hashLink));
      markCurrent(active);
    };

    syncCurrent();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            active.add(entry.target.id);
          } else {
            active.delete(entry.target.id);
          }
        }
        markCurrent(active);
      },
      { threshold: 0.8 },
    );
    headings.forEach(({ heading }) => observer.observe(heading));
    window.addEventListener('hashchange', syncCurrent);
  })();
</script>

<script is:inline>
  (() => {
    const models = [...document.querySelectorAll('details[data-model]')];
    if (models.length === 0) return;
    const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');

    const wanted = slug(new URL(location.href).searchParams.get('model') ?? '');
    const target = wanted
      ? models.find((d) => d.dataset.model === wanted) ??
        models.find((d) => d.dataset.model.startsWith(wanted))
      : undefined;
    if (target) {
      target.open = true;
      target.closest('tr')?.previousElementSibling?.scrollIntoView({ block: 'center' });
    }

    for (const row of document.querySelectorAll('tr.model-row')) {
      row.addEventListener('click', (event) => {
        if (event.target.closest('a')) return;
        const details = document.getElementById(`model-${row.dataset.model}`);
        if (details) details.open = !details.open;
      });
    }

    for (const details of models) {
      details.addEventListener('toggle', () => {
        details.closest('tr')?.previousElementSibling?.classList.toggle('open', details.open);
        const url = new URL(location.href);
        if (details.open) {
          url.searchParams.set('model', details.dataset.model);
        } else if (url.searchParams.get('model') === details.dataset.model) {
          url.searchParams.delete('model');
        } else {
          return;
        }
        history.replaceState(null, '', url);
      });
    }
  })();
</script>

<style>
  .sl-anchor-link {
    position: relative;
  }
</style>
