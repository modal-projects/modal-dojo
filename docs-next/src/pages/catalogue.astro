---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Aside } from '@astrojs/starlight/components';
import CatalogueTable from '../components/CatalogueTable.astro';
import data from '../generated/catalogue.json';
import type { Catalogue } from '../lib/catalogue';

// Regenerate with `uv run scripts/generate_catalogue.py`.
const { benchmark, steps, priced_at: pricedAt, rows } = data as Catalogue;
const hasRuns = rows.some((row) => row.run !== null);
---

<StarlightPage
  frontmatter={{
    title: 'Recipe catalogue',
    description: `Modal Dojo recipes trained for ${steps} steps on ${benchmark}, compared by cost, speed, and reward.`,
    template: 'splash',
    tableOfContents: false,
    order: 0,
  }}
>
  <p>
    Each recipe below trains its model for {steps} steps on {benchmark} on Modal. Filter by base
    model and context length, sort by what a step costs, how long it takes, or the base model's
    reward, and open a recipe to see every step.
  </p>
  {
    !hasRuns && (
      <Aside title="No runs yet">
        Each recipe fills in once its {steps}-step {benchmark} run finishes.
      </Aside>
    )
  }
  <CatalogueTable rows={rows} steps={steps} />
  <h2 id="methodology">How the numbers are computed</h2>
  <ul>
    <li>
      <strong>Context</strong> is the longest sequence, prompt plus response, the recipe rolls out:
      its <code>rollout_max_context_len</code> or SGLang context length when the recipe sets one,
      otherwise the model's own context window from its Hugging Face config, marked default.
    </li>
    <li>
      <strong>Cost / step</strong> is the run's GPU count, times Modal's list price per GPU-hour{
        pricedAt && ` on ${pricedAt}`
      }, times the time per step. CPU, memory, and sandbox time are not included.
    </li>
    <li>
      <strong>Time / step</strong> is the median wall-clock time of the run's steps, covering rollouts,
      training, and weight sync. Checkpoint saves and evals are excluded.
    </li>
    <li>
      <strong>Step 1 reward</strong> is the mean raw reward of the first step's rollouts, which the base
      model generates before any update.
    </li>
    <li>
      The <strong>step breakdown</strong> under each recipe shows every step's time, cost, raw
      reward, and change in reward since step 1. Each step scores a different batch of training
      prompts, so single steps are noisy.
    </li>
    <li>
      <strong>Run</strong> opens the run's page on the Modal Dojo dashboard in a new tab.
    </li>
  </ul>
</StarlightPage>
